<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginStart="@dimen/tv_safe_horizontal"
    android:layout_marginEnd="@dimen/tv_safe_horizontal"
    android:layout_marginBottom="@dimen/video_panel_bottom_margin"
    android:background="@drawable/video_panel_bg"
    android:contentDescription="@string/video_controls_description"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/video_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="32dp"
        android:textColor="@android:color/white"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/video_btn_play"
            style="@style/VideoControlButton"
            android:text="@string/video_pause" />

        <Button
            android:id="@+id/video_btn_back"
            style="@style/VideoControlButton"
            android:text="@string/video_back_10" />

        <Button
            android:id="@+id/video_btn_forward"
            style="@style/VideoControlButton"
            android:text="@string/video_forward_10" />

        <Button
            android:id="@+id/video_btn_speed"
            style="@style/VideoControlButton"
            android:text="@string/video_speed" />

        <Button
            android:id="@+id/video_btn_exit"
            style="@style/VideoControlButton"
            android:text="@string/video_exit_fullscreen" />
    </LinearLayout>
</LinearLayout>
