<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/site_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Saved per-site settings. Hidden in private tabs, which never write to disk. -->
        <LinearLayout
            android:id="@+id/site_saved_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_site_identity" />

                <com.tdarby.comet.ui.TvSettingsSpinner
                    android:id="@+id/spinner_site_identity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:minWidth="180dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_site_viewport" />

                <com.tdarby.comet.ui.TvSettingsSpinner
                    android:id="@+id/spinner_site_viewport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:minWidth="180dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/site_text_size" />

                <com.tdarby.comet.ui.TvSettingsSpinner
                    android:id="@+id/spinner_site_text_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:minWidth="180dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/site_remote_mode" />

                <com.tdarby.comet.ui.TvSettingsSpinner
                    android:id="@+id/spinner_site_remote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:minWidth="180dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/site_allow_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_allow_site" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_site_allow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/site_pause_title"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/site_pause_network" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_pause_network"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="56dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/site_pause_cosmetic" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_pause_cosmetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="56dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/site_pause_popups" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_pause_popups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="56dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/site_pause_redirects" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_pause_redirects"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="56dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/site_blocked_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/site_blocked_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="#33FFFFFF" />

        <Button
            android:id="@+id/site_action_reload"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/tv_button_background"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/site_action_reload"
            android:textAllCaps="false"
            android:textColor="?android:attr/textColorPrimary" />

        <Button
            android:id="@+id/site_action_reset"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/tv_button_background"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/site_action_reset"
            android:textAllCaps="false"
            android:textColor="?android:attr/textColorPrimary" />

        <Button
            android:id="@+id/site_action_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/tv_button_background"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/site_action_diagnostics"
            android:textAllCaps="false"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>
</ScrollView>
